# Copiare in .env.local e riempire. Mai committare i valori veri.
VITE_SUPABASE_URL=https://qonullxzhqvbfpiibqye.supabase.co
VITE_SUPABASE_ANON_KEY=
# Solo lato server (Edge Functions, segreti di Supabase): non vanno nel client.
# NUVOLA_UTENTE=          -> lo inserisce il signore con `supabase secrets set`
# NUVOLA_PASSWORD=        -> idem
# ANTHROPIC_API_KEY=      -> flash card, quiz, enigmi, spiegazioni
# GOOGLE_CALENDAR_ICS_URL= -> indirizzo privato del calendario di famiglia
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY= -> notifiche push
