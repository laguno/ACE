{
  "name": "ace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "ACE: l'app di famiglia per Lani (compiti, studio, organizzazione, percorso Astra)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icone": "node scripts/icone.mjs",
    "simula": "python3 scripts/simula_passi.py 7200 125",
    "prova:schema": "node scripts/prova-schema.mjs",
    "prova:schermate": "playwright test",
    "confronto": "set CONFRONTO=1&& playwright test confronto",
    "lint": "eslint .",
    "copertura": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.include=src/lib/** --coverage.include=supabase/functions/** && node scripts/copertura.mjs",
    "knip": "knip",
    "axe": "set AXE=1&& playwright test accessibilita",
    "lighthouse": "set VITE_SUPABASE_URL=https://finto.supabase.test&& set VITE_SUPABASE_PUBLISHABLE_KEY=finta&& vite build --outDir dist-lh --emptyOutDir && set LH=1&& playwright test lighthouse",
    "tipi:funzioni": "tsc -p supabase/functions",
    "tipi:db": "supabase gen types typescript --local > src/tipi-database.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "knip": "^6.44.2",
    "lighthouse": "^13.6.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
