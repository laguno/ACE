{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Collection", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
